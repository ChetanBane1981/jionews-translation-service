{
  "name": "jionews-sentinel",
  "version": "1.0.0",
  "description": "Autonomous AI Newsroom - Agent-based news pipeline with human oversight",
  "main": "src/orchestrator/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node src/orchestrator/index.js",
    "dev": "ts-node-dev --respawn src/orchestrator/index.ts",
    "api": "node dist/api/server.js",
    "api:dev": "ts-node-dev --respawn src/api/server.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "agent:feed": "ts-node src/agents/feed-agent.ts",
    "agent:detection": "ts-node src/agents/detection-agent.ts",
    "agent:credibility": "ts-node src/agents/credibility-agent.ts",
    "monitor": "ts-node src/monitoring/monitor.ts",
    "db:seed": "ts-node scripts/seed-database.ts",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "keywords": [
    "ai",
    "newsroom",
    "autonomous",
    "agents",
    "llm"
  ],
  "author": "JioNews Team",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "axios": "^1.6.0",
    "bull": "^4.12.0",
    "cors": "^2.8.5",
    "cron": "^3.1.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "mongoose": "^8.0.0",
    "redis": "^4.6.0",
    "rss-parser": "^3.13.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/bull": "^4.10.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.0"
  }
}
